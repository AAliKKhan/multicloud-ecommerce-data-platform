# Copy to .env (git-ignored) and adjust. Local mode needs no cloud credentials.
APP_ENV=local
LOG_LEVEL=INFO

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=commerce

# Events older than this (by event time) are routed to the late-event path.
LATE_EVENT_THRESHOLD_MINUTES=60

# --- Cloud mode only (APP_ENV=dev-cloud or prod-like) ---------------------
# Credentials are NEVER set here: use the AWS / Google credential chains
# (CLI login, environment variables outside this repo, or workload identity).
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ecomm-dev-raw
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=us-central1
# GCS_BUCKET=ecomm-dev-raw-gcs
# BIGQUERY_DATASET=ecomm_dev
